diff --git a/shared/v2/credit-reservations.ts b/shared/v2/credit-reservations.ts
new file mode 100644
--- /dev/null
+++ b/shared/v2/credit-reservations.ts
@@ -0,0 +1,39 @@
+/** Reference reducer for trusted server events, NOT an HTTP wallet or receipt verifier. */
+import {canonicalJson,demand,exact,record} from './edit-plan.js';
+export type Bucket='purchased'|'promotional';
+export interface Allocation {purchased:number;promotional:number;status:'reserved'|'settled'|'released'}
+export interface Wallet {available:Record<Bucket,number>;reservations:Record<string,Allocation>;events:Record<string,string>}
+export type CreditEvent={key:string;kind:'grant';bucket:Bucket;units:number}|{key:string;kind:'reserve';taskId:string;units:number}|{key:string;kind:'settle'|'release';taskId:string};
+const token=(v:unknown)=>typeof v==='string'&&/^[a-zA-Z0-9][a-zA-Z0-9:_-]{0,199}$/.test(v)&&!['__proto__','constructor','prototype'].includes(v);
+const uint=(v:unknown)=>Number.isSafeInteger(v)&&Number(v)>=0;
+const positive=(v:unknown)=>Number.isSafeInteger(v)&&Number(v)>0;
+const add=(a:number,b:number)=>{const n=a+b;demand(uint(n),'UNSAFE_CREDIT_TOTAL');return n;};
+export function emptyWallet():Wallet{return {available:{purchased:0,promotional:0},reservations:Object.create(null),events:Object.create(null)};}
+export function applyCreditEvent(state:Wallet,raw:unknown):Wallet{
+ demand(record(state)&&record(state.available)&&record(state.reservations)&&record(state.events),'INVALID_WALLET');
+ exact(state,['available','reservations','events']);exact(state.available,['purchased','promotional']);
+ demand(uint(state.available.purchased)&&uint(state.available.promotional),'INVALID_BALANCE');add(state.available.purchased,state.available.promotional);
+ for(const [k,v] of Object.entries(state.reservations)){demand(token(k)&&record(v),'INVALID_RESERVATION');exact(v,['purchased','promotional','status']);demand(uint(v.purchased)&&uint(v.promotional)&&['reserved','settled','released'].includes(v.status),'INVALID_RESERVATION');add(v.purchased,v.promotional);}
+ for(const [k,v] of Object.entries(state.events))demand(token(k)&&typeof v==='string','INVALID_EVENT_HISTORY');
+ demand(record(raw),'EVENT_REQUIRED');demand(token(raw.key),'INVALID_EVENT_KEY');demand(typeof raw.kind==='string'&&['grant','reserve','settle','release'].includes(raw.kind),'INVALID_EVENT');
+ exact(raw,raw.kind==='grant'?['key','kind','bucket','units']:raw.kind==='reserve'?['key','kind','taskId','units']:['key','kind','taskId']);
+ if(raw.kind==='grant')demand(typeof raw.bucket==='string'&&['purchased','promotional'].includes(raw.bucket)&&positive(raw.units),'INVALID_GRANT');
+ else {demand(token(raw.taskId),'INVALID_TASK');if(raw.kind==='reserve')demand(positive(raw.units),'INVALID_RESERVE');}
+ const event=raw as CreditEvent,signature=canonicalJson(event);
+ if(Object.hasOwn(state.events,event.key)){demand(state.events[event.key]===signature,'EVENT_KEY_CONFLICT');return state;}
+ const next:Wallet={available:{...state.available},reservations:Object.assign(Object.create(null),state.reservations),events:Object.assign(Object.create(null),state.events)};
+ if(event.kind==='grant'){next.available[event.bucket]=add(next.available[event.bucket],event.units);add(next.available.purchased,next.available.promotional);}
+ else if(event.kind==='reserve'){
+  demand(!Object.hasOwn(next.reservations,event.taskId),'TASK_ALREADY_RESERVED');
+  demand(add(next.available.purchased,next.available.promotional)>=event.units,'INSUFFICIENT_CREDITS');
+  const promo=Math.min(event.units,next.available.promotional),paid=event.units-promo;
+  next.available.promotional-=promo;next.available.purchased-=paid;
+  next.reservations[event.taskId]={purchased:paid,promotional:promo,status:'reserved'};
+ } else {
+  const reservation=next.reservations[event.taskId];demand(reservation,'RESERVATION_NOT_FOUND');
+  if(reservation.status!=='reserved'){demand(reservation.status===(event.kind==='settle'?'settled':'released'),'RESERVATION_TERMINAL_CONFLICT');next.events[event.key]=signature;return next;}
+  if(event.kind==='release'){next.available.purchased=add(next.available.purchased,reservation.purchased);next.available.promotional=add(next.available.promotional,reservation.promotional);}
+  next.reservations[event.taskId]={...reservation,status:event.kind==='settle'?'settled':'released'};
+ }
+ add(next.available.purchased,next.available.promotional);next.events[event.key]=signature;return next;
+}
diff --git a/shared/v2/edit-plan.ts b/shared/v2/edit-plan.ts
new file mode 100644
--- /dev/null
+++ b/shared/v2/edit-plan.ts
@@ -0,0 +1,69 @@
+/** Server-side pure contract. It does not check ownership or authorize a provider call. */
+export const COLORS = ['white','black','silver','graphite','blue','green','red','yellow'] as const;
+export const WHEEL_COLORS = ['silver','graphite','bronze','black','white'] as const;
+export const FINISHES = ['gloss','satin','matte'] as const;
+export const WHEEL_DESIGNS = ['sport_multi_spoke','classic_mesh'] as const;
+export const STYLES = ['clean','sport','dark','heritage','track','rally','touring','color'] as const;
+export const FIELDS = ['bodyColor','wheelColor','bodyFinish','wheelDesign'] as const;
+export type Field = typeof FIELDS[number];
+export type Edit = {action:'preserve'} | {action:'restore_original'} | {action:'set';value:string};
+export type SourceRef = {kind:'original'} | {kind:'version';versionId:string};
+export interface EditRequest {schemaVersion:2;source:SourceRef;operation:'explore'|'detail';styleId?:typeof STYLES[number];edits:Partial<Record<Field,Edit>>}
+export interface Capabilities {enabled:boolean;fields:readonly Field[];originalReference:boolean}
+export interface Observation {value:string;provenance:'verified'|'requested'}
+export type Observations = Partial<Record<Field,Observation>>;
+export class ContractError extends Error { constructor(public readonly code:string){super(code);this.name='ContractError';} }
+export function demand(ok:unknown,code:string):asserts ok {if(!ok)throw new ContractError(code);}
+export function record(v:unknown):v is Record<string,unknown>{return v!==null&&typeof v==='object'&&!Array.isArray(v)&&[Object.prototype,null].includes(Object.getPrototypeOf(v));}
+export function exact(v:Record<string,unknown>,keys:readonly string[]):void{demand(Reflect.ownKeys(v).every(k=>typeof k==='string'&&keys.includes(k)),'UNKNOWN_FIELD');}
+const choices:Record<Field,readonly string[]>={bodyColor:COLORS,wheelColor:WHEEL_COLORS,bodyFinish:FINISHES,wheelDesign:WHEEL_DESIGNS};
+const id=(v:unknown)=>typeof v==='string'&&/^[a-zA-Z0-9_-]{1,128}$/.test(v);
+export function parseEditRequest(value:unknown):EditRequest{
+ demand(record(value),'REQUEST_OBJECT_REQUIRED');exact(value,['schemaVersion','source','operation','styleId','edits']);
+ demand(value.schemaVersion===2,'UNSUPPORTED_SCHEMA');demand(record(value.source),'SOURCE_REQUIRED');
+ const source=value.source;demand(source.kind==='original'||source.kind==='version','INVALID_SOURCE');
+ exact(source,source.kind==='original'?['kind']:['kind','versionId']);if(source.kind==='version')demand(id(source.versionId),'INVALID_VERSION_ID');
+ demand(value.operation==='explore'||value.operation==='detail','INVALID_OPERATION');
+ if(value.operation==='explore'){demand(source.kind==='original','EXPLORE_REQUIRES_ORIGINAL');demand(STYLES.includes(value.styleId as typeof STYLES[number]),'INVALID_STYLE');}
+ else demand(value.styleId===undefined,'DETAIL_MUST_NOT_APPLY_STYLE');
+ demand(record(value.edits),'EDITS_REQUIRED');exact(value.edits,FIELDS);
+ const edits:Partial<Record<Field,Edit>>={};
+ for(const field of FIELDS){const item=value.edits[field];if(item===undefined)continue;
+  demand(record(item),'INVALID_EDIT');demand(typeof item.action==='string'&&['preserve','restore_original','set'].includes(item.action),'INVALID_ACTION');
+  exact(item,item.action==='set'?['action','value']:['action']);
+  if(item.action==='set'){demand(typeof item.value==='string'&&choices[field].includes(item.value),'UNSUPPORTED_VALUE');edits[field]={action:'set',value:item.value};}
+  else edits[field]={action:item.action as 'preserve'|'restore_original'};
+ }
+ return {schemaVersion:2,source:source.kind==='original'?{kind:'original'}:{kind:'version',versionId:source.versionId as string},operation:value.operation,...(value.operation==='explore'?{styleId:value.styleId as typeof STYLES[number]}:{}),edits};
+}
+export interface ResolvedEdit {field:Field;action:'set'|'restore_original';value?:string}
+/** Call only after expanding the chosen, versioned server preset into explicit edits. */
+export function resolveEdits(raw:unknown,cap:Capabilities,base:Observations={}):{request:EditRequest;changes:ResolvedEdit[];preserve:Field[]}{
+ const request=parseEditRequest(raw);demand(record(cap),'INVALID_CAPABILITY');exact(cap,['enabled','fields','originalReference']);demand(cap.enabled===true,'CAPABILITY_DISABLED');
+ demand(Array.isArray(cap.fields)&&cap.fields.every(f=>FIELDS.includes(f))&&typeof cap.originalReference==='boolean','INVALID_CAPABILITY');
+ demand(record(base),'INVALID_OBSERVATIONS');exact(base,FIELDS);
+ for(const field of FIELDS){const o=base[field];if(o===undefined)continue;demand(record(o),'INVALID_OBSERVATION');exact(o,['value','provenance']);demand(typeof o.value==='string'&&choices[field].includes(o.value)&&['verified','requested'].includes(o.provenance),'INVALID_OBSERVATION');}
+ const changes:ResolvedEdit[]=[];
+ for(const field of FIELDS){const edit=request.edits[field];if(!edit||edit.action==='preserve')continue;
+  demand(cap.fields.includes(field),'FIELD_NOT_ENABLED');
+  if(edit.action==='restore_original'){if(request.source.kind==='original')continue;demand(cap.originalReference,'ORIGINAL_REFERENCE_UNSUPPORTED');changes.push({field,action:'restore_original'});}
+  else {const observation=base[field];if(observation?.provenance==='verified'&&observation.value===edit.value)continue;changes.push({field,action:'set',value:edit.value});}
+ }
+ demand(changes.length>0,'NO_EFFECTIVE_CHANGE');
+ return {request,changes,preserve:FIELDS.filter(f=>!changes.some(c=>c.field===f))};
+}
+/** Data-only canonical JSON. Unknown/unsupported JS values fail rather than disappear. */
+export function canonicalJson(value:unknown):string{
+ const active=new Set<object>();
+ const visit=(v:unknown):unknown=>{
+  if(v===null||typeof v==='string'||typeof v==='boolean')return v;
+  if(typeof v==='number'){demand(Number.isFinite(v),'NON_FINITE_NUMBER');return v;}
+  demand(Array.isArray(v)||record(v),'NON_JSON_VALUE');demand(!active.has(v as object),'CYCLIC_VALUE');active.add(v as object);
+  let out:unknown;
+  if(Array.isArray(v)){demand(Reflect.ownKeys(v).length===v.length+1&&v.every((_item,i)=>Object.hasOwn(v,i))&&Array.from({length:v.length},(_item,i)=>Object.hasOwn(v,i)).every(Boolean),'SPARSE_OR_EXTRA_ARRAY');out=v.map(visit);}
+  else {demand(Reflect.ownKeys(v).every(k=>typeof k==='string'),'SYMBOL_KEY');const next:Record<string,unknown>=Object.create(null);for(const k of Object.keys(v).sort())next[k]=visit(v[k]);out=next;}
+  active.delete(v as object);return out;
+ };return JSON.stringify(visit(value));
+}
+/** Hash all frozen semantics with owner identity; HTTP replay lookup remains owner-scoped. */
+export async function semanticDigest(value:unknown):Promise<string>{const bytes=new TextEncoder().encode(canonicalJson(value));const hash=await globalThis.crypto.subtle.digest('SHA-256',bytes);return Array.from(new Uint8Array(hash),b=>b.toString(16).padStart(2,'0')).join('');}
diff --git a/shared/v2/form-quality-policy.ts b/shared/v2/form-quality-policy.ts
new file mode 100644
--- /dev/null
+++ b/shared/v2/form-quality-policy.ts
@@ -0,0 +1,43 @@
+/** Pure recommendation policy. NOT a quality detector, authorizer, or money writer. */
+export type Problem = 'identity_changed' | 'target_not_applied' | 'unwanted_structure' | 'image_artifacts';
+export type Decision = { deliver: boolean; creditAction: 'settle' | 'release'; quality: 'unassessed' | 'accepted' | 'rejected'; reason: string };
+export interface PixelDigest { normalizerVersion: string; sha256: string; width: number; height: number }
+export interface OutputCheck {requestedEdits: number;decode: 'valid' | 'invalid';sourcePixels?: PixelDigest;outputPixels?: PixelDigest;assessment?: { status: 'not_assessed' | 'accepted' | 'rejected'; issue?: Problem };}
+const issues: readonly Problem[] = ['identity_changed','target_not_applied','unwanted_structure','image_artifacts'];
+const object = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && !Array.isArray(v) && [Object.prototype, null].includes(Object.getPrototypeOf(v));
+function demand(ok: unknown, message: string): asserts ok { if (!ok) throw new Error(message); }
+function exact(v: Record<string, unknown>, allowed: string[]) { demand(Reflect.ownKeys(v).every(k => typeof k === 'string' && allowed.includes(k)), 'Unknown field'); }
+function digest(v: unknown): PixelDigest {
+ demand(object(v), 'Pixel digest object required'); exact(v,['normalizerVersion','sha256','width','height']);
+ demand(typeof v.normalizerVersion === 'string' && /^[a-zA-Z0-9._-]{1,80}$/.test(v.normalizerVersion), 'Normalizer version required');
+ demand(typeof v.sha256 === 'string' && /^[a-f0-9]{64}$/.test(v.sha256), 'Normalized pixel SHA256 required');
+ demand(Number.isSafeInteger(v.width) && Number(v.width)>0 && Number(v.width)<=40000, 'Invalid width');
+ demand(Number.isSafeInteger(v.height) && Number(v.height)>0 && Number(v.height)<=40000, 'Invalid height');
+ return v as unknown as PixelDigest;
+}
+/** Hash canonical oriented, color-normalized RGBA pixels, NOT encoded PNG/JPEG bytes. */
+export function sameNormalizedPixels(a: PixelDigest, b: PixelDigest): boolean {const x=digest(a),y=digest(b);return x.normalizerVersion===y.normalizerVersion && x.width===y.width && x.height===y.height && x.sha256===y.sha256;}
+/** Server must construct assessment from its approved review record, never client claims. */
+export function classifyOutput(input: OutputCheck): Decision {
+ demand(object(input),'Output check object required');exact(input,['requestedEdits','decode','sourcePixels','outputPixels','assessment']);
+ demand(Number.isSafeInteger(input.requestedEdits) && input.requestedEdits>0,'At least one resolved edit required');
+ demand(input.decode==='valid'||input.decode==='invalid','Invalid decode result');
+ if(input.sourcePixels!==undefined) digest(input.sourcePixels);if(input.outputPixels!==undefined) digest(input.outputPixels);
+ if(input.assessment!==undefined) {const a=input.assessment;demand(object(a),'Assessment object required');exact(a,['status','issue']);demand(['not_assessed','accepted','rejected'].includes(a.status),'Invalid assessment status');if(a.status==='rejected') demand(issues.includes(a.issue as Problem),'A supported issue is required');else demand(a.issue===undefined,'Issue contradicts assessment status');}
+ if(input.decode==='invalid') return {deliver:false,creditAction:'release',quality:'rejected',reason:'OUTPUT_INVALID'};
+ if(input.sourcePixels && input.outputPixels && sameNormalizedPixels(input.sourcePixels,input.outputPixels))return {deliver:false,creditAction:'release',quality:'rejected',reason:'OUTPUT_UNCHANGED'};
+ if(input.assessment?.status==='rejected')return {deliver:false,creditAction:'release',quality:'rejected',reason:input.assessment.issue!.toUpperCase()};
+ return {deliver:true,creditAction:'settle',quality:input.assessment?.status==='accepted'?'accepted':'unassessed',reason:'OUTPUT_DELIVERABLE'};
+}
+export interface CompensationInput {rootTaskId:string;taskStatus:'succeeded'|'failed'|'cancelled'|'processing';creditCost:number;rootAlreadyCompensated:boolean;review:'approved'|'pending'|'rejected';policyVersion:string}
+/** Pure plan only: transaction + UNIQUE(root_task_id) are mandatory during integration. */
+export function planCompensation(v:CompensationInput):{grantUnits:number;benefitKey:string;eventKey:string;reason:string}{
+ demand(object(v),'Compensation object required');exact(v,['rootTaskId','taskStatus','creditCost','rootAlreadyCompensated','review','policyVersion']);
+ demand(typeof v.rootTaskId==='string' && /^[a-zA-Z0-9_-]{1,128}$/.test(v.rootTaskId),'Invalid root task');
+ demand(typeof v.policyVersion==='string' && /^[a-zA-Z0-9._-]{1,80}$/.test(v.policyVersion),'Invalid policy version');
+ demand(['succeeded','failed','cancelled','processing'].includes(v.taskStatus),'Invalid task status');demand(['approved','pending','rejected'].includes(v.review),'Invalid review');
+ demand(Number.isSafeInteger(v.creditCost) && v.creditCost>0,'Invalid frozen task cost');demand(typeof v.rootAlreadyCompensated==='boolean','Invalid duplicate state');
+ const benefitKey=`quality_compensation:${v.rootTaskId}`,eventKey=`${benefitKey}:${v.policyVersion}`;
+ const grant=v.taskStatus==='succeeded' && v.review==='approved' && !v.rootAlreadyCompensated;
+ return {grantUnits:grant?v.creditCost:0,benefitKey,eventKey,reason:grant?'APPROVED_COMPENSATION':'NO_NEW_COMPENSATION'};
+}
