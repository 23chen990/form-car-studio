{
  "name": "form-car-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1 --strictPort\"",
    "dev:test": "node tools/dev-test.mjs",
    "build": "node tools/license-notices.mjs && tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "assets:demo": "node --import tsx tools/build-demo.ts",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios",
    "cap:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" CODE_SIGNING_ALLOWED=NO",
    "cap:run": "npm run cap:sync && cap run ios"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "express": "^5.1.0",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-compare-slider": "4.0.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@capacitor/cli": "8.5.3"
  }
}
