# Local demo runs without an image API key.
FORM_MODE=demo
PORT=3001
FORM_WEB_ORIGIN=http://127.0.0.1:5173

# SQLite and private image storage. Use a separate directory for live mode.
FORM_DATA_DIR=data

# Optional starting balance for NEW browser sessions only.
# Defaults: demo=12, live=0. This is an internal credit ledger, not payment.
# FORM_INITIAL_CREDITS=12

# Required only for live image editing. Keep these values on the server.
# IMAGE_API_KEY=
# IMAGE_MODEL=
# IMAGE_BASE_URL=https://api.openai.com/v1
