+++ b/tests/v2/contracts.test.mjs
@@ -0,0 +1,40 @@
+import {test} from 'node:test';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
+import {parseEditRequest,resolveEdits,canonicalJson,semanticDigest} from '../../shared/v2/edit-plan.js';
+import {buildEditPrompt} from '../../shared/v2/provider-prompt.js';
+const cap={enabled:true,fields:['bodyColor','wheelColor','bodyFinish','wheelDesign'],originalReference:true};
+const req={schemaVersion:2,source:{kind:'original'},operation:'detail',edits:{bodyColor:{action:'set',value:'blue'}}};
+const error=(fn,code)=>assert.throws(fn,e=>e.code===code);
+test('direct original edit does not need a previous version',()=>assert.equal(resolveEdits(req,cap).changes[0].value,'blue'));
+test('specific version ID is retained',()=>assert.equal(parseEditRequest({...req,source:{kind:'version',versionId:'old-v1'}}).source.versionId,'old-v1'));
+test('parser copies nested edits',()=>{const r=parseEditRequest(req);r.edits.bodyColor.value='red';assert.equal(req.edits.bodyColor.value,'blue');});
+test('unknown top field rejected',()=>error(()=>parseEditRequest({...req,projectName:'ignore rules'}),'UNKNOWN_FIELD'));
+test('unknown edit field rejected',()=>error(()=>parseEditRequest({...req,edits:{spoiler:{action:'set',value:'big'}}}),'UNKNOWN_FIELD'));
+test('old raw target is not silently treated as new contract',()=>error(()=>parseEditRequest({target:{bodyColor:'blue'}}),'UNKNOWN_FIELD'));
+test('explore must start from original',()=>error(()=>parseEditRequest({...req,operation:'explore',styleId:'sport',source:{kind:'version',versionId:'v1'}}),'EXPLORE_REQUIRES_ORIGINAL'));
+test('all historical style IDs still parse for explore',()=>{for(const styleId of ['clean','sport','dark','heritage','track','rally','touring','color'])assert.equal(parseEditRequest({...req,operation:'explore',styleId}).styleId,styleId);});
+test('detail request cannot smuggle a style',()=>error(()=>parseEditRequest({...req,styleId:'sport'}),'DETAIL_MUST_NOT_APPLY_STYLE'));
+for(const value of ['pink','keep','ruby red','',null,4])test(`unsupported body color ${value}`,()=>error(()=>parseEditRequest({...req,edits:{bodyColor:{action:'set',value}}}),'UNSUPPORTED_VALUE'));
+for(const source of [{kind:'latest'},{kind:'version',versionId:'../secret'},{kind:'original',versionId:'v1'}])test(`bad source ${JSON.stringify(source)}`,()=>assert.throws(()=>parseEditRequest({...req,source})));
+test('preserve cannot carry a hidden value',()=>error(()=>parseEditRequest({...req,edits:{bodyColor:{action:'preserve',value:'blue'}}}),'UNKNOWN_FIELD'));
+test('preserve all is a no-op',()=>error(()=>resolveEdits({...req,edits:{bodyColor:{action:'preserve'}}},cap),'NO_EFFECTIVE_CHANGE'));
+test('no-op requires verified base, not requested recipe',()=>{assert.equal(resolveEdits(req,cap,{bodyColor:{value:'blue',provenance:'requested'}}).changes.length,1);error(()=>resolveEdits(req,cap,{bodyColor:{value:'blue',provenance:'verified'}}),'NO_EFFECTIVE_CHANGE');});
+test('one verified unchanged field removed while other change remains',()=>{const r=resolveEdits({...req,edits:{...req.edits,wheelColor:{action:'set',value:'bronze'}}},cap,{bodyColor:{value:'blue',provenance:'verified'}});assert.deepEqual(r.changes,[{field:'wheelColor',action:'set',value:'bronze'}]);assert.ok(r.preserve.includes('bodyColor'));});
+test('restore original from original is no-op',()=>error(()=>resolveEdits({...req,edits:{bodyColor:{action:'restore_original'}}},cap),'NO_EFFECTIVE_CHANGE'));
+test('restore original requires reference capability',()=>error(()=>resolveEdits({...req,source:{kind:'version',versionId:'v1'},edits:{bodyColor:{action:'restore_original'}}},{...cap,originalReference:false}),'ORIGINAL_REFERENCE_UNSUPPORTED'));
+test('restore original does not guess an unknown color',()=>assert.deepEqual(resolveEdits({...req,source:{kind:'version',versionId:'v1'},edits:{bodyColor:{action:'restore_original'}}},cap).changes,[{field:'bodyColor',action:'restore_original'}]));
+test('disabled capability is closed',()=>error(()=>resolveEdits(req,{...cap,enabled:false}),'CAPABILITY_DISABLED'));
+test('disabled field is closed',()=>error(()=>resolveEdits(req,{...cap,fields:['wheelColor']}),'FIELD_NOT_ENABLED'));
+test('invalid observation provenance rejected',()=>error(()=>resolveEdits(req,cap,{bodyColor:{value:'blue',provenance:'assumed'}}),'INVALID_OBSERVATION'));
+test('JSON key order canonical',()=>assert.equal(canonicalJson({b:2,a:{z:1,y:3}}),canonicalJson({a:{y:3,z:1},b:2})));
+test('digest matches SHA256 of canonical JSON',async()=>assert.equal(await semanticDigest(req),createHash('sha256').update(canonicalJson(req)).digest('hex')));
+test('source, output, price and policy versions change digest',async()=>{const base={owner:'u1',request:req,output:'standard',units:1,policy:'1',provider:'a'};const h=await semanticDigest(base);for(const change of [{owner:'u2'},{output:'large'},{units:2},{policy:'2'},{provider:'b'},{request:{...req,source:{kind:'version',versionId:'v1'}}}])assert.notEqual(await semanticDigest({...base,...change}),h);});
+for(const value of [undefined,NaN,Infinity,()=>0,BigInt(1),new Date()])test(`non JSON ${String(value)}`,()=>assert.throws(()=>canonicalJson(value)));
+test('cyclic input rejected',()=>{const a={};a.a=a;error(()=>canonicalJson(a),'CYCLIC_VALUE');});
+test('shared non cyclic object allowed',()=>{const a={x:1};assert.equal(canonicalJson({a,b:a}),'{"a":{"x":1},"b":{"x":1}}');});
+test('sparse or extended arrays rejected',()=>{const a=new Array(1);a.foo=1;assert.throws(()=>canonicalJson(a));const b=[1];b.extra=2;assert.throws(()=>canonicalJson(b));const c=[1];c[Symbol('s')]=3;assert.throws(()=>canonicalJson(c));});
+test('symbol object keys rejected',()=>assert.throws(()=>canonicalJson({[Symbol('k')]:1})));
+test('proto key encoded as data, never mutates global',()=>{const obj=JSON.parse('{"__proto__":{"test":1},"a":2}');assert.equal(canonicalJson(obj),'{"__proto__":{"test":1},"a":2}');assert.equal({}.test,undefined);});
+test('color prompt preserves wheel structure',()=>{const p=buildEditPrompt(req,cap);assert.match(p,/Keep existing wheel spoke structure/);assert.doesNotMatch(p,/sport multi-spoke wheels/);});
+test('wheel design prompt permits design only, keeps tire geometry',()=>{const p=buildEditPrompt({...req,edits:{wheelDesign:{action:'set',value:'sport_multi_spoke'}}},cap);assert.match(p,/Change the visible wheel spoke appearance only/);assert.doesNotMatch(p,/Preserve the current generic wheel spoke design/);assert.match(p,/tire geometry/);});
+test('prompt cannot accept arbitrary notes',()=>assert.throws(()=>buildEditPrompt({...req,note:'replace car'},cap)));
+test('no broad preserve geometry instruction contradicts wheel design',()=>assert.doesNotMatch(buildEditPrompt({...req,edits:{wheelDesign:{action:'set',value:'classic_mesh'}}},cap),/do not alter any vehicle geometry/i));
diff --git a/tests/v2/credit.test.mjs b/tests/v2/credit.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/v2/credit.test.mjs
@@ -0,0 +1,27 @@
+import {test} from 'node:test';import assert from 'node:assert/strict';import {emptyWallet,applyCreditEvent as apply} from '../../shared/v2/credit-reservations.js';
+const seed=()=>apply(apply(emptyWallet(),{key:'purchase:t1',kind:'grant',bucket:'purchased',units:5}),{key:'promo:p1',kind:'grant',bucket:'promotional',units:1});
+const reserve={key:'reserve:task1',kind:'reserve',taskId:'task1',units:2};
+test('promo consumed before purchased',()=>{const w=apply(seed(),reserve);assert.deepEqual(w.available,{purchased:4,promotional:0});assert.deepEqual(w.reservations.task1,{purchased:1,promotional:1,status:'reserved'});});
+test('release restores exact buckets',()=>{const w=apply(apply(seed(),reserve),{key:'release:task1',kind:'release',taskId:'task1'});assert.deepEqual(w.available,seed().available);});
+test('settle does not charge again',()=>{const w=apply(apply(seed(),reserve),{key:'settle:task1',kind:'settle',taskId:'task1'});assert.deepEqual(w.available,{purchased:4,promotional:0});assert.equal(w.reservations.task1.status,'settled');});
+test('identical grant replay no duplication',()=>{const e={key:'purchase:a',kind:'grant',bucket:'purchased',units:5};const w=apply(emptyWallet(),e);assert.equal(apply(w,e),w);});
+test('same event key with different body is rejected',()=>assert.throws(()=>apply(seed(),{key:'purchase:t1',kind:'grant',bucket:'purchased',units:10}),/EVENT_KEY_CONFLICT/));
+test('identical reserve replay idempotent',()=>{const w=apply(seed(),reserve);assert.equal(apply(w,reserve),w);});
+test('same task cannot reserve under different key',()=>assert.throws(()=>apply(apply(seed(),reserve),{...reserve,key:'another'}),/TASK_ALREADY_RESERVED/));
+for(const kind of ['settle','release'])test(`repeat ${kind} under different key preserves money and records replay identity`,()=>{const w=apply(apply(seed(),reserve),{key:'terminal',kind,taskId:'task1'});const next=apply(w,{key:'new-terminal',kind,taskId:'task1'});assert.deepEqual(next.available,w.available);assert.deepEqual(next.reservations,w.reservations);assert.ok(Object.hasOwn(next.events,'new-terminal'));});
+test('release cannot rewrite settled history',()=>assert.throws(()=>apply(apply(apply(seed(),reserve),{key:'s',kind:'settle',taskId:'task1'}),{key:'r',kind:'release',taskId:'task1'}),/RESERVATION_TERMINAL_CONFLICT/));
+test('late settle after release rejected',()=>assert.throws(()=>apply(apply(apply(seed(),reserve),{key:'r',kind:'release',taskId:'task1'}),{key:'s',kind:'settle',taskId:'task1'}),/RESERVATION_TERMINAL_CONFLICT/));
+test('insufficient credits changes nothing',()=>{const w=seed(),before=JSON.stringify(w);assert.throws(()=>apply(w,{...reserve,units:7}),/INSUFFICIENT_CREDITS/);assert.equal(JSON.stringify(w),before);});
+for(const units of [0,-1,1.1,NaN,Infinity,'2',Number.MAX_SAFE_INTEGER+1])test(`bad grant ${units}`,()=>assert.throws(()=>apply(seed(),{key:'x',kind:'grant',bucket:'purchased',units})));
+test('addition overflow rejected',()=>{const w=apply(emptyWallet(),{key:'max',kind:'grant',bucket:'purchased',units:Number.MAX_SAFE_INTEGER});assert.throws(()=>apply(w,{key:'one',kind:'grant',bucket:'purchased',units:1}),/UNSAFE_CREDIT_TOTAL/);});
+test('unrecognized bucket rejected',()=>assert.throws(()=>apply(seed(),{key:'x',kind:'grant',bucket:'cash',units:1})));
+test('unknown field such as client price rejected',()=>assert.throws(()=>apply(seed(),{...reserve,price:0}),/UNKNOWN_FIELD/));
+test('prototype keys rejected',()=>assert.throws(()=>apply(seed(),{...reserve,key:'__proto__'}),/INVALID_EVENT_KEY/));
+test('missing reservation rejected',()=>assert.throws(()=>apply(seed(),{key:'r',kind:'release',taskId:'missing'}),/RESERVATION_NOT_FOUND/));
+test('prior nested records remain unchanged',()=>{const w=apply(seed(),reserve),before=JSON.stringify(w);apply(w,{key:'r',kind:'release',taskId:'task1'});assert.equal(JSON.stringify(w),before);});
+test('ledger accepts only trusted server grants, not receipt fields',()=>assert.throws(()=>apply(seed(),{key:'purchase:a',kind:'grant',bucket:'purchased',units:5,verifiedByClient:true}),/UNKNOWN_FIELD/));
+
+for(const kind of ['settle','release'])test(`recorded duplicate ${kind} key cannot become a grant`,()=>{const w=apply(apply(seed(),reserve),{key:'done',kind,taskId:'task1'});const next=apply(w,{key:'duplicate',kind,taskId:'task1'});assert.throws(()=>apply(next,{key:'duplicate',kind:'grant',bucket:'purchased',units:1}),/EVENT_KEY_CONFLICT/);});
+test('cross-bucket grant overflow rejected before mutation',()=>{const w=apply(emptyWallet(),{key:'max',kind:'grant',bucket:'purchased',units:Number.MAX_SAFE_INTEGER});assert.throws(()=>apply(w,{key:'promo',kind:'grant',bucket:'promotional',units:1}),/UNSAFE_CREDIT_TOTAL/);});
+test('invalid cross-bucket starting sum rejected',()=>{const w=emptyWallet();w.available={purchased:Number.MAX_SAFE_INTEGER,promotional:1};assert.throws(()=>apply(w,{key:'grant',kind:'grant',bucket:'purchased',units:1}),/UNSAFE_CREDIT_TOTAL/);});
+test('release cannot overflow aggregate available balance',()=>{let w=apply(emptyWallet(),{key:'p',kind:'grant',bucket:'promotional',units:Number.MAX_SAFE_INTEGER});w=apply(w,{key:'res',kind:'reserve',taskId:'task',units:1});w=apply(w,{key:'paid',kind:'grant',bucket:'purchased',units:1});assert.throws(()=>apply(w,{key:'release',kind:'release',taskId:'task'}),/UNSAFE_CREDIT_TOTAL/);});
diff --git a/tests/v2/quality.test.mjs b/tests/v2/quality.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/v2/quality.test.mjs
@@ -0,0 +1,25 @@
+import {test} from 'node:test';import assert from 'node:assert/strict';
+import {classifyOutput,sameNormalizedPixels,planCompensation} from '../../shared/v2/form-quality-policy.js';
+const px={normalizerVersion:'rgba-srgb-v1',sha256:'a'.repeat(64),width:640,height:480};const good={requestedEdits:1,decode:'valid'};
+test('valid pixels without review are not quality verified',()=>{const r=classifyOutput(good);assert.equal(r.quality,'unassessed');assert.equal(r.deliver,true)});
+test('invalid output returns reserved credit',()=>assert.equal(classifyOutput({...good,decode:'invalid'}).creditAction,'release'));
+test('exact normalized identity rejects no change',()=>assert.equal(classifyOutput({...good,sourcePixels:px,outputPixels:{...px}}).reason,'OUTPUT_UNCHANGED'));
+test('identity evidence overrides accepted annotation',()=>assert.equal(classifyOutput({...good,sourcePixels:px,outputPixels:px,assessment:{status:'accepted'}}).deliver,false));
+for (const key of ['sha256','normalizerVersion','width','height']) test(`different ${key} is not exact equality`,()=>{const b={...px,[key]:key==='sha256'?'b'.repeat(64):key==='normalizerVersion'?'rgba-v2':999};assert.equal(sameNormalizedPixels(px,b),false)});
+for (const issue of ['identity_changed','target_not_applied','unwanted_structure','image_artifacts']) test(`confirmed ${issue} rejects`,()=>assert.equal(classifyOutput({...good,assessment:{status:'rejected',issue}}).deliver,false));
+test('accepted review stays accepted',()=>assert.equal(classifyOutput({...good,assessment:{status:'accepted'}}).quality,'accepted'));
+for(const requestedEdits of [0,-1,NaN,1.5,'1'])test(`bad edit count ${requestedEdits}`,()=>assert.throws(()=>classifyOutput({...good,requestedEdits})));
+test('unknown input field rejected',()=>assert.throws(()=>classifyOutput({...good,qualityPassed:true})));
+test('empty pixel normalizer rejected',()=>assert.throws(()=>sameNormalizedPixels({...px,normalizerVersion:''},px)));
+test('file hash field not accepted as pixel digest',()=>assert.throws(()=>sameNormalizedPixels({...px,fileHash:px.sha256},px)));
+test('contradictory review rejected',()=>assert.throws(()=>classifyOutput({...good,assessment:{status:'accepted',issue:'identity_changed'}})));
+test('rejected review needs category',()=>assert.throws(()=>classifyOutput({...good,assessment:{status:'rejected'}})));
+const comp={rootTaskId:'root-1',taskStatus:'succeeded',creditCost:1,rootAlreadyCompensated:false,review:'approved',policyVersion:'v1'};
+test('approved compensation uses frozen cost',()=>assert.equal(planCompensation({...comp,creditCost:2}).grantUnits,2));
+for(const taskStatus of ['failed','cancelled','processing'])test(`no double benefit for ${taskStatus}`,()=>assert.equal(planCompensation({...comp,taskStatus}).grantUnits,0));
+for(const review of ['pending','rejected'])test(`no credit for ${review}`,()=>assert.equal(planCompensation({...comp,review}).grantUnits,0));
+test('already compensated stays zero across policy change',()=>assert.equal(planCompensation({...comp,rootAlreadyCompensated:true,policyVersion:'v2'}).grantUnits,0));
+test('root-level benefit stable across versions',()=>assert.equal(planCompensation(comp).benefitKey,planCompensation({...comp,policyVersion:'v2'}).benefitKey));
+test('invalid coercion rejected',()=>assert.throws(()=>planCompensation({...comp,rootAlreadyCompensated:0})));
+test('unsafe root rejected',()=>assert.throws(()=>planCompensation({...comp,rootTaskId:'../user'})));
+test('functions do not mutate inputs',()=>{const s=JSON.stringify(comp);planCompensation(comp);assert.equal(JSON.stringify(comp),s)});
diff --git a/tests/v2/task-launch.test.mjs b/tests/v2/task-launch.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/v2/task-launch.test.mjs
@@ -0,0 +1,22 @@
+import {test} from 'node:test';import assert from 'node:assert/strict';import {transition} from '../../shared/v2/task-policy.js';import {canGrantTrial,marketFromStorefront} from '../../shared/v2/launch-policy.js';
+test('queued starts once',()=>assert.deepEqual(transition('queued','start'),{status:'processing',credits:'none',upstream:'start_once'}));
+test('queued cancellation releases without upstream',()=>assert.deepEqual(transition('queued','cancel'),{status:'cancelled',credits:'release',upstream:'none'}));
+test('processing cancel must not pretend cost-free',()=>assert.throws(()=>transition('processing','cancel'),/ALREADY_SUBMITTED/));
+test('processing failure releases user reservation',()=>assert.equal(transition('processing','technical_failure').credits,'release'));
+test('deliver settles',()=>assert.equal(transition('processing','deliver').credits,'settle'));
+test('restart processing becomes uncertain without retry',()=>assert.deepEqual(transition('processing','restart'),{status:'uncertain',credits:'none',upstream:'no_auto_retry'}));
+test('uncertain expiry fails and releases user only',()=>assert.equal(transition('uncertain','recovery_expired').credits,'release'));
+test('uncertain cannot be restarted as a new provider call',()=>assert.throws(()=>transition('uncertain','start'),/ILLEGAL_TRANSITION/));
+for(const s of ['queued','processing','uncertain','succeeded','failed','cancelled'])test(`leaving ${s} never changes state or charges`,()=>assert.deepEqual(transition(s,'leave'),{status:s,credits:'none',upstream:'none'}));
+for(const s of ['succeeded','failed','cancelled'])test(`late output to ${s} does nothing`,()=>assert.deepEqual(transition(s,'deliver'),{status:s,credits:'none',upstream:'none'}));
+test('queued cannot deliver',()=>assert.throws(()=>transition('queued','deliver'),/ILLEGAL_TRANSITION/));
+test('invalid states fail',()=>assert.throws(()=>transition('unknown','start'),/INVALID_STATE/));
+const policy={enabled:true,units:1,budgetApproved:true,stableAccount:true,claimedBefore:false,reservedExposureMicros:20,spentMicros:30,newMaxCostMicros:50,budgetMicros:100};
+test('trial exact budget boundary allowed only pending transaction',()=>assert.equal(canGrantTrial(policy).reason,'ELIGIBLE_PENDING_ATOMIC_RESERVATION'));
+test('trial cannot exceed reserved exposure',()=>assert.equal(canGrantTrial({...policy,newMaxCostMicros:51}).reason,'TRIAL_BUDGET_EXHAUSTED'));
+for(const change of [{enabled:false},{budgetApproved:false},{stableAccount:false},{claimedBefore:true},{units:0},{budgetMicros:0},{newMaxCostMicros:0}])test(`closed trial ${JSON.stringify(change)}`,()=>assert.equal(canGrantTrial({...policy,...change}).allowed,false));
+test('unknown cost is not zero',()=>assert.throws(()=>canGrantTrial({...policy,newMaxCostMicros:null})));
+test('unsafe sum closes trial',()=>assert.equal(canGrantTrial({...policy,spentMicros:Number.MAX_SAFE_INTEGER,budgetMicros:Number.MAX_SAFE_INTEGER}).allowed,false));
+test('boolean strings rejected',()=>assert.throws(()=>canGrantTrial({...policy,budgetApproved:'true'})));
+test('ISO3 normalized explicitly',()=>{assert.equal(marketFromStorefront('USA'),'US');assert.equal(marketFromStorefront('GBR'),'GB');});
+for(const value of ['en-US','US','en','GB','__proto__','constructor',null,1])test(`not a known storefront ${value}`,()=>assert.equal(marketFromStorefront(value),null));
diff --git a/tools/check-v2.mjs b/tools/check-v2.mjs
new file mode 100644
--- /dev/null
+++ b/tools/check-v2.mjs
@@ -0,0 +1,18 @@
+import {mkdtempSync,writeFileSync,mkdirSync,copyFileSync,rmSync,readdirSync,existsSync} from 'node:fs';
+import {tmpdir} from 'node:os';import {resolve,join,dirname} from 'node:path';import {fileURLToPath} from 'node:url';import {spawnSync} from 'node:child_process';
+const root=resolve(dirname(fileURLToPath(import.meta.url)),'..');
+const out=mkdtempSync(join(tmpdir(),'form-v2-tests-'));
+const modules=['edit-plan','task-policy','credit-reservations','launch-policy','provider-prompt','form-quality-policy'];
+const referenceTests=['contracts.test.mjs','credit.test.mjs','task-launch.test.mjs','quality.test.mjs'];
+const run=(cmd,args)=>{const r=spawnSync(cmd,args,{cwd:root,stdio:'inherit'});if(r.error||r.status!==0)throw r.error||new Error(`Exit ${r.status}`);};
+try {
+ const local=join(root,'node_modules/.bin/tsc');
+ const compiler=process.env.FORM_TSC_BIN||(existsSync(local)?local:'tsc');
+ const config={compilerOptions:{target:'ES2023',module:'ESNext',moduleResolution:'Bundler',strict:true,lib:['ES2023','DOM'],types:[],rootDir:root,outDir:out,noEmitOnError:true},files:modules.map(f=>join(root,'shared/v2',f+'.ts'))};
+ writeFileSync(join(out,'tsconfig.json'),JSON.stringify(config));run(compiler,['-p',join(out,'tsconfig.json')]);
+ writeFileSync(join(out,'package.json'),'{'+'"type":"module"'+'}');mkdirSync(join(out,'tests/v2'),{recursive:true});
+ for(const f of referenceTests)copyFileSync(join(root,'tests/v2',f),join(out,'tests/v2',f));
+ run(process.execPath,['--test',...referenceTests.map(f=>join(out,'tests/v2',f))]);
+ const other=readdirSync(join(root,'tests/v2')).filter(f=>/\.test\.(ts|tsx|mjs)$/.test(f)&&!referenceTests.includes(f)).sort();
+ if(other.length)run(process.execPath,['--import','tsx','--test',...other.map(f=>join(root,'tests/v2',f))]);
+} catch(e){console.error(e);process.exitCode=1;} finally {rmSync(out,{recursive:true,force:true});}
